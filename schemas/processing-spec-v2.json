{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "rgbd-workbench/processing-spec"
    },
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "roi": {
      "anyOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        {
          "type": "null"
        }
      ]
    },
    "depthMin": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "depthMax": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "xyzMin": {
      "anyOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "null"
        }
      ]
    },
    "xyzMax": {
      "anyOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "null"
        }
      ]
    },
    "pixelStride": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "maxPoints": {
      "type": "integer",
      "minimum": 100,
      "maximum": 2000000
    },
    "voxelSize": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "knnFilter": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "k": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "stdRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            }
          },
          "required": ["k", "stdRatio"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "knnSmooth": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "k": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          },
          "required": ["k"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "roi",
    "depthMin",
    "depthMax",
    "xyzMin",
    "xyzMax",
    "pixelStride",
    "maxPoints",
    "voxelSize",
    "knnFilter",
    "knnSmooth"
  ],
  "additionalProperties": false
}

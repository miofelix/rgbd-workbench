{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "rgbd-workbench/derivation"
    },
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "derivationKey": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sceneId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "sceneHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "processorVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "processing": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "rgbd-workbench/processing-spec"
        },
        "schemaVersion": {
          "type": "number",
          "const": 2
        },
        "roi": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              ],
              "items": false,
              "minItems": 4,
              "maxItems": 4
            },
            {
              "type": "null"
            }
          ]
        },
        "depthMin": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "depthMax": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "xyzMin": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "xyzMax": {
          "anyOf": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "pixelStride": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "maxPoints": {
          "type": "integer",
          "minimum": 100,
          "maximum": 2000000
        },
        "voxelSize": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "knnFilter": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "k": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                },
                "stdRatio": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 5
                }
              },
              "required": ["k", "stdRatio"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "knnSmooth": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "k": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 64
                }
              },
              "required": ["k"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "format",
        "schemaVersion",
        "roi",
        "depthMin",
        "depthMax",
        "xyzMin",
        "xyzMax",
        "pixelStride",
        "maxPoints",
        "voxelSize",
        "knnFilter",
        "knnSmooth"
      ],
      "additionalProperties": false
    },
    "pointCount": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 2000000
    },
    "sourceShape": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "frameId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "unit": {
      "type": "string",
      "enum": ["m", "unitless"]
    },
    "representation": {
      "type": "string",
      "enum": ["z_depth", "relative_z"]
    },
    "bounds": {
      "type": "object",
      "properties": {
        "min": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "max": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": ["min", "max"],
      "additionalProperties": false
    },
    "arrays": {
      "type": "object",
      "properties": {
        "positions": {
          "type": "object",
          "properties": {
            "dataType": {
              "type": "string",
              "enum": ["float32", "uint8", "uint32"]
            },
            "shape": {
              "minItems": 1,
              "maxItems": 2,
              "type": "array",
              "items": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "byteOffset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "byteLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["dataType", "shape", "byteOffset", "byteLength"],
          "additionalProperties": false
        },
        "colors": {
          "type": "object",
          "properties": {
            "dataType": {
              "type": "string",
              "enum": ["float32", "uint8", "uint32"]
            },
            "shape": {
              "minItems": 1,
              "maxItems": 2,
              "type": "array",
              "items": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "byteOffset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "byteLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["dataType", "shape", "byteOffset", "byteLength"],
          "additionalProperties": false
        },
        "sourcePixelIndex": {
          "type": "object",
          "properties": {
            "dataType": {
              "type": "string",
              "enum": ["float32", "uint8", "uint32"]
            },
            "shape": {
              "minItems": 1,
              "maxItems": 2,
              "type": "array",
              "items": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "byteOffset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "byteLength": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["dataType", "shape", "byteOffset", "byteLength"],
          "additionalProperties": false
        }
      },
      "required": ["positions", "colors", "sourcePixelIndex"],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "derivationKey",
    "sceneId",
    "sceneHash",
    "processorVersion",
    "processing",
    "pointCount",
    "sourceShape",
    "frameId",
    "unit",
    "representation",
    "bounds",
    "arrays"
  ],
  "additionalProperties": false
}

{
  "$defs": {
    "ArrayDescriptorV1": {
      "additionalProperties": false,
      "properties": {
        "dtype": {
          "enum": [
            "float32",
            "uint8",
            "uint32"
          ],
          "title": "Dtype",
          "type": "string"
        },
        "nbytes": {
          "minimum": 0,
          "title": "Nbytes",
          "type": "integer"
        },
        "offset": {
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "shape": {
          "items": {
            "type": "integer"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Shape",
          "type": "array"
        }
      },
      "required": [
        "dtype",
        "shape",
        "offset",
        "nbytes"
      ],
      "title": "ArrayDescriptorV1",
      "type": "object"
    },
    "BoundsV1": {
      "additionalProperties": false,
      "properties": {
        "max": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Max",
          "type": "array"
        },
        "min": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Min",
          "type": "array"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "title": "BoundsV1",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capability"
        },
        "code": {
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "fatal"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "KNNFilterSpec": {
      "additionalProperties": false,
      "properties": {
        "k": {
          "default": 16,
          "maximum": 64,
          "minimum": 1,
          "title": "K",
          "type": "integer"
        },
        "std_ratio": {
          "default": 2.0,
          "maximum": 5,
          "minimum": 0,
          "title": "Std Ratio",
          "type": "number"
        }
      },
      "title": "KNNFilterSpec",
      "type": "object"
    },
    "KNNSmoothSpec": {
      "additionalProperties": false,
      "properties": {
        "k": {
          "default": 16,
          "maximum": 64,
          "minimum": 1,
          "title": "K",
          "type": "integer"
        }
      },
      "title": "KNNSmoothSpec",
      "type": "object"
    },
    "ProcessingSpecV1": {
      "additionalProperties": false,
      "properties": {
        "depth_max": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depth Max"
        },
        "depth_min": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depth Min"
        },
        "knn_filter": {
          "anyOf": [
            {
              "$ref": "#/$defs/KNNFilterSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "knn_smooth": {
          "anyOf": [
            {
              "$ref": "#/$defs/KNNSmoothSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_points": {
          "default": 2000000,
          "maximum": 2000000,
          "minimum": 100,
          "title": "Max Points",
          "type": "integer"
        },
        "pixel_stride": {
          "default": 1,
          "minimum": 1,
          "title": "Pixel Stride",
          "type": "integer"
        },
        "roi": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Roi"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "voxel_size": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Voxel Size"
        },
        "xyz_max": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xyz Max"
        },
        "xyz_min": {
          "anyOf": [
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xyz Min"
        }
      },
      "title": "ProcessingSpecV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "arrays": {
      "additionalProperties": {
        "$ref": "#/$defs/ArrayDescriptorV1"
      },
      "title": "Arrays",
      "type": "object"
    },
    "bounds": {
      "$ref": "#/$defs/BoundsV1"
    },
    "created_at": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "derivation_id": {
      "pattern": "^derivation-[a-f0-9]{64}$",
      "title": "Derivation Id",
      "type": "string"
    },
    "derivation_key": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Derivation Key",
      "type": "string"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "frame": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Frame",
      "type": "string"
    },
    "point_count": {
      "exclusiveMinimum": 0,
      "maximum": 2000000,
      "title": "Point Count",
      "type": "integer"
    },
    "processing": {
      "$ref": "#/$defs/ProcessingSpecV1"
    },
    "processor_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Processor Version",
      "type": "string"
    },
    "representation": {
      "enum": [
        "z_depth",
        "relative_z"
      ],
      "title": "Representation",
      "type": "string"
    },
    "scene_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Scene Hash",
      "type": "string"
    },
    "scene_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Scene Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_shape": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Source Shape",
      "type": "array"
    },
    "unit": {
      "enum": [
        "m",
        "unitless"
      ],
      "title": "Unit",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "derivation_id",
    "scene_id",
    "scene_hash",
    "derivation_key",
    "processor_version",
    "processing",
    "point_count",
    "source_shape",
    "frame",
    "unit",
    "representation",
    "bounds",
    "arrays"
  ],
  "title": "DerivationManifestV1",
  "type": "object"
}

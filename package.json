{
  "name": "rgbd-workbench",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run schemas && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schemas": "node scripts/generate-schemas.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run schemas:check && npm test && npm run build",
    "schemas:check": "node scripts/generate-schemas.mjs --check",
    "test:unit": "vitest run tests/domain tests/compute tests/trajectory tests/render",
    "check:pages": "node scripts/check-pages.mjs"
  },
  "dependencies": {
    "canonicalize": "^5.1.0",
    "fast-png": "^8.0.0",
    "fflate": "^0.8.3",
    "geotiff": "^3.0.5",
    "idb": "^8.0.4",
    "lucide-react": "^0.468.0",
    "mediabunny": "^1.62.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "description": "Private, deterministic RGB-D analysis and camera-path rendering in the browser",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  }
}
